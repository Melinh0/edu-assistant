# Configurações do Edu Assistant
# Copie este arquivo para .env e preencha os valores

# Host do Ollama (padrão: https://ollama.com)
OLLAMA_HOST=https://ollama.com

# Chaves API do Ollama (rotação automática em caso de quota/rate limit)
# Separe múltiplas chaves por vírgula
OLLAMA_API_KEYS=0590f77641954364887a5826e17f42a8.54gAswHj3VMFhHLu5_ybe2bF,102a20fbcfbc4a1da7ff2376d3a89699.FSZQ3P9pJ-zdMek-pgjN6Dd6,5b50d694e76b49b1971cc154e0c95cd3.12XTD_-IQm23HRPj9XXOKfa6,a9fc50b1437148d48f3284acbe7e5d92.j_msPN0RlWmvgqp0ZzgYl4ps,b2e05185f4cf4f97ad68fc38947c8651.QPhTVEiTbD1mz115wjm5gdPD,e1ff7924336a43eea683c4a95628d7fe.RF0p72Lja55xMYbDiDBynzi1,c93c4e2cc6624fb59f9bb0747d10c3ea.xNTSpxHPGINfFU6C0d259hzD

# (Opcional) Chave única Ollama - alternativa ao OLLAMA_API_KEYS
# OLLAMA_API_KEY=

# Configurações do modelo
OLLAMA_MAX_TOKENS=8192
OLLAMA_AVAILABLE_MODELS=gemma4:31b-cloud
OLLAMA_VISION_MODELS=gemma4:31b-cloud

# Chaves API da NVIDIA (para NVIDIA NIM / NVIDIA AI Foundation Models)
# Separe múltiplas chaves por vírgula
# NVIDIA_API_KEYS=nvapi-xxx,nvapi-yyy

# Configurações de extração
MAX_CONTEXT_CHARS=50000
CHUNK_SIZE=5000
OCR_SPACE_API_KEY=
EXTRACTION_CACHE=1
LLM_REFINE=0
OCR_WORKERS=4

# Alunos padrão (criados automaticamente se não existirem)
ALUNOS_PADRAO=maurinho,maria